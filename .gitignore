**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Chave de assinatura de upload (T19). O keystore e a senha dele nunca vao
# para o repositorio: quem tem os dois consegue publicar uma atualizacao do
# app se passando por voce.
android/key.properties
*.jks
*.keystore

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Testes, documentação e a configuração do Firebase ficavam de fora do
# versionamento, seguindo o padrão do repositório de referência da
# disciplina. Com o projeto passando para outras pessoas isso deixou de
# fazer sentido: sem `firestore.rules` ninguém consegue publicar a segurança
# do banco, e sem `test/` e `docs/` quem clona recebe o código sem as
# verificações nem o histórico de decisões. Os únicos arquivos que seguem
# fora são os que carregam segredo — a chave de assinatura e a senha dela,
# protegidas mais acima.
